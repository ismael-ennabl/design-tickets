#!/bin/sh
# Blocks commits when shared-components.md is out of sync with _shared/*.jsx
# Install once (from repo root): git config core.hooksPath .githooks

BUILDER_DIR="$(git rev-parse --show-toplevel)/builder"

if [ -d "$BUILDER_DIR" ]; then
  node "$BUILDER_DIR/scripts/check-drift.js"
  if [ $? -ne 0 ]; then
    echo ""
    echo "  Run: cd builder && npm run build"
    echo ""
    exit 1
  fi
fi
